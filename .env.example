# ===================================================================
# Environment Variables Template
# Copy per service and keep only variables used by that service.
# ===================================================================

# ===== GitHub Secrets (CI/CD) =====
# AWS_ROLE_ARN          - IAM Role ARN for GitHub OIDC
# DB_USERNAME           - RDS master username
# DB_PASSWORD           - RDS master password
# GEMINI_API_KEY        - (opcional) será definido pela equipe IADT quando integrar

# ===== Common AWS =====
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=                    # Empty for real AWS, http://localhost:4566 for LocalStack

# ===== upload-service (Java/Spring) =====
DB_HOST=localhost
DB_NAME=upload_db
DB_USER=postgres
DB_PASS=postgres
AWS_S3_BUCKET_NAME=architecture-diagrams-dev
AWS_SNS_FILE_UPLOADED_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:file-uploaded-topic-dev
AWS_ENDPOINT=http://localhost:4566
SPRING_PROFILES_ACTIVE=local

# ===== processing-service (Python/FastAPI) =====
REDIS_URL=                           # Empty = in-memory deduplication
S3_BUCKET_NAME=architecture-diagrams-dev
SQS_QUEUE_URL=http://localhost:4566/000000000000/file-uploaded-queue-dev
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:diagram-processed-topic-dev
AWS_ENDPOINT_URL=http://localhost:4566

# ===== ai-analysis-service (Python/FastAPI) =====
# TODO: Variáveis de ambiente do LLM serão definidas pela equipe IADT
SQS_QUEUE_URL=http://localhost:4566/000000000000/diagram-processed-queue-dev
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:analysis-completed-topic-dev
AWS_ENDPOINT_URL=http://localhost:4566

# ===== report-service (Java/Spring) =====
DB_HOST=localhost
DB_NAME=report_db
DB_USER=postgres
DB_PASS=postgres
AWS_SQS_ANALYSIS_COMPLETED_QUEUE_URL=http://localhost:4566/000000000000/analysis-completed-queue-dev
AWS_ENDPOINT=http://localhost:4566
SPRING_PROFILES_ACTIVE=local

# ===== status-service (Java/Spring) =====
DB_HOST=localhost
DB_NAME=status_db
DB_USER=postgres
DB_PASS=postgres
AWS_SQS_FILE_UPLOADED_QUEUE_URL=http://localhost:4566/000000000000/status-file-uploaded-queue-dev
AWS_SQS_DIAGRAM_PROCESSED_QUEUE_URL=http://localhost:4566/000000000000/status-diagram-processed-queue-dev
AWS_SQS_ANALYSIS_COMPLETED_QUEUE_URL=http://localhost:4566/000000000000/status-analysis-completed-queue-dev
AWS_ENDPOINT=http://localhost:4566
SPRING_PROFILES_ACTIVE=local

# ===== api-gateway (Java/Spring) =====
COGNITO_USER_POOL_ID=mock-pool-id
ALLOW_INSECURE_LOCAL_API=true
UPLOAD_SERVICE_URL=http://localhost:8081
REPORT_SERVICE_URL=http://localhost:8084
STATUS_SERVICE_URL=http://localhost:8085
SPRING_PROFILES_ACTIVE=local
